# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault

# LLM provider: gemini | fake (fake = deterministic stub, no network)
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main model: OCR + field extraction + summary card + chat answers
GEMINI_MODEL=gemini-3.5-flash-lite
# Cheap model: routes chat questions to documents by their summary cards
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Worker
WORKER_POLL_SECONDS=2
MAX_UPLOAD_MB=20
